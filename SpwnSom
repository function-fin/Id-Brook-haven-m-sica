-- FUNÇÃO DE DISPARO - SINCRONIZAÇÃO DE ÁUDIO FE
-------------------------------------------------------------------
local function syncAllAudio(audioId)
    local RE = ReplicatedStorage:WaitForChild("RE", 5)
    if not RE then return end
    
    local idStr = tostring(audioId)
    local isStopping = (idStr == "0" or idStr == "")

    -- 1. CASAS
    local houseEvent = RE:FindFirstChild("1Player1sHous1e")
    if houseEvent then
        houseEvent:FireServer("PickHouseMusicText", idStr, 4, true)
        houseEvent:FireServer("PickHouseMusicText", idStr)
    end

    -- 2. CARROS
    local carEvent = RE:FindFirstChild("1Player1sCa1r")
    if carEvent then
        if isStopping then
            carEvent:FireServer("MusicStop", "", 4, true)
            carEvent:FireServer("PickingCarMusicText", "")
        else
            carEvent:FireServer("MusicText", idStr, 4, true)
            carEvent:FireServer("PickingCarMusicText", idStr)
            carEvent:FireServer("PickingCarMusicText", idStr, 4, true)
        end
    end

    -- 3. RÁDIO TOOL
    local toolEvent = RE:FindFirstChild("PlayerToolEvent")
    if toolEvent then
        toolEvent:FireServer("ToolMusicText", idStr, 4, true)
    end

    -- 4. HOVERBOARD / SCOOTER
    local bikeEvent = RE:FindFirstChild("1NoMoto1rVehicle1s")
    if bikeEvent then
        if isStopping then
            bikeEvent:FireServer("PickingScooterMusicStop", "", 4, true)
        else
            bikeEvent:FireServer("PickingScooterMusicText", idStr, 4, true)
        end
    end

    -- 5. PROPS (Caixa de som)
    local propEvent = RE:FindFirstChild("Props")
    if propEvent then
        propEvent:FireServer("PropMusicText", idStr, 4, true)
    end
end


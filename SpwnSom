-- Persistência de Dados (JSON)
local function loadPlaylist()
    local success, result = pcall(function() return readfile and readfile(FILE_NAME) end)
    if success and result then
        local decodeSuccess, decodedData = pcall(function() return HttpService:JSONDecode(result) end)
        if decodeSuccess and type(decodedData) == "table" then savedSongs = decodedData return end
    end
end
local function savePlaylist() pcall(function() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(savedSongs)) end end) end
loadPlaylist()

-- Sincronização de Áudio FE
local function syncAllAudio(audioId)
    local RE = ReplicatedStorage:WaitForChild("RE", 5) if not RE then return end
    local idStr, isStopping = tostring(audioId), (tostring(audioId) == "0" or tostring(audioId) == "")
    local events = {["1Player1sHous1e"] = {"PickHouseMusicText", idStr}, ["PlayerToolEvent"] = {"ToolMusicText", idStr, 4, true}, ["Props"] = {"PropMusicText", idStr, 4, true}}

    for name, args in pairs(events) do
        local ev = RE:FindFirstChild(name)
        if ev then ev:FireServer(unpack(args)) if name == "1Player1sHous1e" then ev:FireServer(args[1], args[2], 4, true) end end
    end
    local car = RE:FindFirstChild("1Player1sCa1r")
    if car then if isStopping then car:FireServer("MusicStop", "", 4, true) car:FireServer("PickingCarMusicText", "") else car:FireServer("MusicText", idStr, 4, true) car:FireServer("PickingCarMusicText", idStr) car:FireServer("PickingCarMusicText", idStr, 4, true) end end
    local bike = RE:FindFirstChild("1NoMoto1rVehicle1s")
    if bike then bike:FireServer(isStopping and "PickingScooterMusicStop" or "PickingScooterMusicText", isStopping and "" or idStr, 4, true) end
end


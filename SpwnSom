-- Tabela interna de músicas 
local savedSongs = {}

-- Função Segura para Carregar Playlist Salva
local function loadPlaylist()
    local success, result = pcall(function()
        if readfile then
            return readfile(FILE_NAME)
        end
    end)
    
    if success and result then
        local decodeSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(result)
        end)
        if decodeSuccess and type(decodedData) == "table" then
            savedSongs = decodedData
            return
        end
    end
    savedSongs = {}
end

-- Função Segura para Salvar Playlist Localmente
local function savePlaylist()
    pcall(function()
        if writefile then
            local jsonString = HttpService:JSONEncode(savedSongs)
            writefile(FILE_NAME, jsonString)
        end
    end)
end

-- Inicializa carregando os dados salvos anteriormente

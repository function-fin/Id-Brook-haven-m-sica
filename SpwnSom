-- Atualização Visual Dinâmica da Playlist
local updatePlaylistVisual
updatePlaylistVisual = function()
    for _, child in ipairs(SongScroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
    for index, data in ipairs(savedSongs) do
        local Card = Create("Frame", SongScroll, {Size = UDim2.new(1, -6, 0, 50), BackgroundColor3 = Color_Card, BorderSizePixel = 0})
        Create("UICorner", Card, {CornerRadius = UDim.new(0, 10)})
        local CardPlay = Create("ImageButton", Card, {Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(0, 10, 0.5, -13), BackgroundTransparency = 1, Image = (isPlaying and currentPlayingId == tostring(data.id)) and ID_PAUSE or ID_PLAY})
        Create("TextLabel", Card, {Size = UDim2.new(0.55, 0, 0, 18), Position = UDim2.new(0, 45, 0, 16), BackgroundTransparency = 1, Text = data.name, TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left})
        Create("TextLabel", Card, {Size = UDim2.new(0.55, 0, 0, 14), Position = UDim2.new(0, 45, 0, 3), BackgroundTransparency = 1, Text = "Id (" .. data.id .. ")", TextColor3 = Color3.fromRGB(140,140,140), Font = Enum.Font.GothamMedium, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left})
        Create("TextLabel", Card, {Size = UDim2.new(0.55, 0, 0, 12), Position = UDim2.new(0, 45, 0, 33), BackgroundTransparency = 1, Text = data.duration or "00:00", TextColor3 = Color3.fromRGB(100,100,100), Font = Enum.Font.GothamMedium, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left})
        
        -- Substituído por ImageButton com o ID X solicitado
        local DelBtn = Create("ImageButton", Card, {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -30, 0.5, -10), BackgroundTransparency = 1, Image = ID_DELETE_X})

        CardPlay.MouseButton1Click:Connect(function()
            local targetId = tostring(data.id)
            isPlaying = not (isPlaying and currentPlayingId == targetId)
            currentPlayingId = isPlaying and targetId or ""
            PlayBtn.Image = isPlaying and ID_PAUSE or ID_PLAY
            if isPlaying then IdInput.Text = "Id ("..targetId..")" end
            syncAllAudio(isPlaying and targetId or "0")
            updatePlaylistVisual()
        end)
        DelBtn.MouseButton1Click:Connect(function()
            if currentPlayingId == tostring(data.id) then isPlaying, currentPlayingId, PlayBtn.Image = false, "", ID_PLAY syncAllAudio("0") end
            table.remove(savedSongs, index) savePlaylist() updatePlaylistVisual()
        end)
    end
    SongScroll.CanvasSize = UDim2.new(0, 0, 0, ScrollLayout.AbsoluteContentSize.Y + 10)
end
updatePlaylistVisual()


-- SISTEMA DE PLACEHOLDERS INTERATIVOS (TEXTBOXES)
-------------------------------------------------------------------
local function configurePlaceholder(box, placeholderText)
    box.Focused:Connect(function()
        if box.Text == placeholderText then
            box.Text = ""
            box.TextColor3 = Color3.new(1, 1, 1)
        end
    end)
    box.FocusLost:Connect(function()
        if box.Text == "" then
            box.Text = placeholderText
            box.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end)
end

configurePlaceholder(IdInput, "Id (...)")
configurePlaceholder(NewIdInput, "Novo ID")
configurePlaceholder(NewNameInput, "Nome")

-------------------------------------------------------------------
-- DRAGGABLE (ARRASTAR AS INTERFACES LIVREMENTE)
-------------------------------------------------------------------
local function makeDraggable(obj)
    local dragging, dragStart, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = obj.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(OpenBtn)
makeDraggable(MainFrame)
